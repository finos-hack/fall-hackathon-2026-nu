{
  "$id": "https://agip.example/patterns/P14-autonomous-agent-execution.json",
  "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
  "description": "Agent decisions executed with an audit trail.",
  "metadata": {
    "approved_by": "architecture-review",
    "pattern-id": "P14",
    "related_controls": [
      "AIGF-MI-021"
    ],
    "related_risks": [
      "AIGF-RI-018",
      "AIGF-RI-022"
    ],
    "status": "APPROVED",
    "version": 1
  },
  "properties": {
    "nodes": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "https://calm.finos.org/release/1.2/meta/core.json#/defs/node",
          "properties": {
            "description": {
              "const": "AI agent that executes decisions."
            },
            "metadata": {
              "properties": {
                "autonomy": {
                  "enum": [
                    "supervised",
                    "semi-autonomous",
                    "autonomous"
                  ]
                },
                "decision_impact": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "financial"
                  ]
                }
              },
              "required": [
                "autonomy",
                "decision_impact"
              ],
              "type": "object"
            },
            "name": {
              "const": "Agent"
            },
            "node-type": {
              "const": "ai:agent"
            },
            "unique-id": {
              "const": "agent"
            }
          },
          "required": [
            "unique-id",
            "node-type",
            "name",
            "description",
            "metadata"
          ],
          "type": "object"
        },
        {
          "$ref": "https://calm.finos.org/release/1.2/meta/core.json#/defs/node",
          "properties": {
            "description": {
              "const": "Records agent decisions for review."
            },
            "metadata": {
              "properties": {
                "role": {
                  "const": "audit"
                }
              },
              "required": [
                "role"
              ],
              "type": "object"
            },
            "name": {
              "const": "Audit Service"
            },
            "node-type": {
              "const": "service"
            },
            "unique-id": {
              "const": "audit-service"
            }
          },
          "required": [
            "unique-id",
            "node-type",
            "name",
            "description",
            "metadata"
          ],
          "type": "object"
        }
      ],
      "type": "array"
    },
    "relationships": {
      "maxItems": 1,
      "minItems": 1,
      "prefixItems": [
        {
          "$ref": "https://calm.finos.org/release/1.2/meta/core.json#/defs/relationship",
          "properties": {
            "description": {
              "const": "Agent decisions are recorded"
            },
            "relationship-type": {
              "const": {
                "connects": {
                  "destination": {
                    "node": "audit-service"
                  },
                  "source": {
                    "node": "agent"
                  }
                }
              }
            },
            "unique-id": {
              "const": "agent-is-audited"
            }
          },
          "required": [
            "unique-id",
            "description",
            "relationship-type"
          ],
          "type": "object"
        }
      ],
      "type": "array"
    }
  },
  "required": [
    "nodes",
    "relationships"
  ],
  "title": "P14 Autonomous Agent Execution",
  "type": "object"
}
