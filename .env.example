# Copy to .env (never commit .env). Every connection setting lives here.

# Decider (remote Strands Decider endpoint, e.g. on EC2)
DECIDER_PROVIDER=http        # http|fixture
DECIDER_URL=http://<ec2-host>:8000   # POST /v1/systemone, GET /health
DECIDER_MODEL=
DECIDER_TIMEOUT_S=10

# Model gateway (Amazon Bedrock called directly via the Strands runtime; uses AWS credentials)
MODEL_PROVIDER=bedrock       # bedrock|none|replay
AWS_REGION=us-east-1
AWS_PROFILE=
BEDROCK_MODEL_ID=<set-me>

# Workflow executor
EXECUTOR=direct              # direct|fluxnova
FLUXNOVA_URL=http://localhost:8080/engine-rest

# py-pglite (local)
PGLITE_HOST=127.0.0.1
PGLITE_PORT=5433
PGLITE_DATA_DIR=data/pglite

# CLI tools (local)
CALM_BIN=calm
SPECTRAL_BIN=spectral
TOOL_TIMEOUT_S=60

# Data
DATA_DIR=data

# Source checkouts for `python -m rule_authoring.ingest`
AIGF_PATH=../ai-governance-framework
CCC_PATH=../common-cloud-controls
