{
  "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
  "metadata": {
    "id": "customer-support-gap-v2",
    "name": "Customer Support Agent - GAP Version",
    "description": "Initial customer support agent architecture with security gaps (no authorization, no audit)"
  },
  "nodes": [
    {
      "unique-id": "user",
      "node-type": "actor",
      "name": "Customer",
      "description": "End customer interacting with the support agent",
      "metadata": {}
    },
    {
      "unique-id": "support-agent",
      "node-type": "ai-agent",
      "name": "Support Agent",
      "description": "Autonomous customer-support AI agent",
      "metadata": {
        "autonomy_level": "autonomous",
        "has_external_action": true,
        "can_perform_high_impact_action": true,
        "accesses_sensitive_data": true,
        "has_external_connectivity": true,
        "has_tool_access": true,
        "capabilities": ["tool_invocation", "api_calling", "data_access"]
      }
    },
    {
      "unique-id": "customer-data",
      "node-type": "datastore",
      "name": "Customer Data",
      "description": "Datastore holding customer PII and order history",
      "metadata": {
        "data_classification": "confidential",
        "contains_pii": true,
        "access_control_type": "none",
        "controls": []
      }
    },
    {
      "unique-id": "internet",
      "node-type": "external-system",
      "name": "Internet",
      "description": "Public internet accessed by the agent",
      "metadata": {
        "trust_level": "untrusted",
        "requires_authentication": false,
        "encryption_support": false
      }
    },
    {
      "unique-id": "refund-api",
      "node-type": "external-system",
      "name": "Refund API",
      "description": "External refund processing API",
      "metadata": {
        "high_impact_capability": true,
        "trust_level": "trusted",
        "requires_authentication": false,
        "encryption_support": false
      }
    }
  ],
  "relationships": [
    {
      "unique-id": "r1",
      "description": "Customer interacts with support agent",
      "relationship-type": {
        "interacts": {
          "actor": "user",
          "nodes": ["support-agent"]
        }
      }
    },
    {
      "unique-id": "r2",
      "description": "Agent accesses customer data",
      "relationship-type": {
        "connects": {
          "source": {"node": "support-agent"},
          "destination": {"node": "customer-data"}
        }
      },
      "metadata": {"governance_type": "can-access"}
    },
    {
      "unique-id": "r3",
      "description": "Agent accesses the internet",
      "relationship-type": {
        "connects": {
          "source": {"node": "support-agent"},
          "destination": {"node": "internet"}
        }
      },
      "metadata": {"governance_type": "can-access"}
    },
    {
      "unique-id": "r4",
      "description": "Agent invokes the refund API",
      "relationship-type": {
        "connects": {
          "source": {"node": "support-agent"},
          "destination": {"node": "refund-api"}
        }
      },
      "metadata": {"governance_type": "invokes"}
    }
  ]
}
