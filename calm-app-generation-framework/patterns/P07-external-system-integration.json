{
  "$id": "https://agip.example/patterns/P07-external-system-integration.json",
  "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
  "description": "A system outside the trust boundary.",
  "metadata": {
    "approved_by": "architecture-review",
    "pattern-id": "P07",
    "related_controls": [
      "CCC.VPC",
      "AIGF-MI-017"
    ],
    "related_risks": [
      "AIGF-RI-024"
    ],
    "status": "APPROVED",
    "version": 1
  },
  "properties": {
    "nodes": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "https://calm.finos.org/release/1.2/meta/core.json#/defs/node",
          "properties": {
            "description": {
              "const": "System operated outside the application boundary."
            },
            "metadata": {
              "properties": {
                "exposure": {
                  "const": "external"
                },
                "mediation": {
                  "enum": [
                    "gateway",
                    "none"
                  ]
                },
                "role": {
                  "type": "string"
                }
              },
              "required": [
                "exposure",
                "mediation",
                "role"
              ],
              "type": "object"
            },
            "name": {
              "const": "External System"
            },
            "node-type": {
              "const": "service"
            },
            "unique-id": {
              "const": "external-system"
            }
          },
          "required": [
            "unique-id",
            "node-type",
            "name",
            "description",
            "metadata"
          ],
          "type": "object"
        },
        {
          "$ref": "https://calm.finos.org/release/1.2/meta/core.json#/defs/node",
          "properties": {
            "description": {
              "const": "Caller (connection point)"
            },
            "name": {
              "const": "Caller"
            },
            "node-type": {
              "const": "service"
            },
            "unique-id": {
              "const": "caller"
            }
          },
          "required": [
            "unique-id",
            "node-type",
            "name",
            "description"
          ],
          "type": "object"
        }
      ],
      "type": "array"
    },
    "relationships": {
      "maxItems": 1,
      "minItems": 1,
      "prefixItems": [
        {
          "$ref": "https://calm.finos.org/release/1.2/meta/core.json#/defs/relationship",
          "properties": {
            "description": {
              "const": "Caller invokes the external system"
            },
            "relationship-type": {
              "const": {
                "connects": {
                  "destination": {
                    "node": "external-system"
                  },
                  "source": {
                    "node": "caller"
                  }
                }
              }
            },
            "unique-id": {
              "const": "caller-calls-external"
            }
          },
          "required": [
            "unique-id",
            "description",
            "relationship-type"
          ],
          "type": "object"
        }
      ],
      "type": "array"
    }
  },
  "required": [
    "nodes",
    "relationships"
  ],
  "title": "P07 External System Integration",
  "type": "object"
}
